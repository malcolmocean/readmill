{
  "manifest_version": 3,
  "name": "Readmill",
  "version": "0.1.0",
  "description": "Step through any web page sentence by sentence (Tab / Enter, foot-pedal friendly) and leave margin comments saved as files on disk.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Readmill: toggle on this page",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle Readmill on this page"
    }
  }
}
